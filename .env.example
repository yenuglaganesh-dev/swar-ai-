# SWAR AI Environment Variables
# Copy this file to .env and fill in values.

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# AI Provider (required for real AI responses) - Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent
GEMINI_MODEL=gemini-3-flash-preview
# Optional: vision-capable model. Use a model listed in https://ai.google.dev/gemini-api/docs/models with chat-completions support.
GEMINI_VISION_MODEL=gemini-3-flash-preview

# External APIs (optional but enables real weather/news)
WEATHER_API_KEY=your_openweathermap_api_key_here
NEWS_API_KEY=your_newsapi_key_here
DEFAULT_WEATHER_LOCATION=Hyderabad

# Supabase (required for auth, profiles, conversation storage, memory, RLS)
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
