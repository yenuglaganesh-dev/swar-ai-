# SWAR AI Environment Variables
# Copy this file to .env and fill in values.

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# AI Provider (required for real AI responses) - OpenCode Inference Chat Completions API
AI_API_KEY=your_opencode_api_key_here
AI_API_URL=https://opencode.ai/inference/openai/v1/chat/completions
AI_MODEL=big-pickle
# Optional: vision-capable model. Use a model listed in https://opencode.ai/inference/v1/models with chat-completions support.
AI_VISION_MODEL=big-pickle

# External APIs (optional but enables real weather/news)
WEATHER_API_KEY=35807bf6ccf2842093e7d9e02cd223fd
NEWS_API_KEY=ff9cbf9a27b840948364d8aea4991daas
DEFAULT_WEATHER_LOCATION=Hyderabad

# Supabase (required for auth, profiles, conversation storage, memory, RLS)
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
